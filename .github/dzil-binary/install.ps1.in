# Installer for the binaries of @REPO@ @VERSION@ (release @TAG@).
#   powershell -File install.ps1 [name ...]      default: all of @BINARIES@
# Environment (prefix @ENV@_): VERSION, INSTALL_DIR, PLATFORM, BASE_URL
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$Tag = '@TAG@'
$Version = '@VERSION@'
$Binaries = '@BINARIES@'.Split(' ')
$Platforms = '@PLATFORMS@'.Split(' ')

function Get-Setting($name) { [Environment]::GetEnvironmentVariable('@ENV@_' + $name) }

$Base = Get-Setting 'BASE_URL'
if (-not $Base) { $Base = 'https://github.com/@OWNER@/@REPO@/releases' }
$Dir = Get-Setting 'INSTALL_DIR'
if (-not $Dir) { $Dir = Join-Path $env:LOCALAPPDATA 'Programs\@DIST@' }
$Pin = Get-Setting 'VERSION'
if ($Pin) {
  $Prefix = $Tag.Substring(0, $Tag.Length - $Version.Length)
  $Tag = $Prefix + $Pin
  $Version = $Pin
}

$Platform = Get-Setting 'PLATFORM'
if (-not $Platform) { $Platform = 'windows-x86_64' }
if ($Platforms -notcontains $Platform) {
  throw "No build for platform $Platform. Built platforms: $($Platforms -join ' ')"
}

$Selected = $Binaries
if ($args.Count -gt 0) {
  foreach ($a in $args) {
    if ($Binaries -notcontains $a) { throw "Unknown binary: $a. Available: $($Binaries -join ' ')" }
  }
  $Selected = $args
}
$Suffix = ''
if ($Platform -eq 'windows-x86_64') { $Suffix = '.exe' }

New-Item -ItemType Directory -Force -Path $Dir | Out-Null
$Url = "$Base/download/$Tag"
$Temps = @()
try {
  $SumsFile = Join-Path $Dir ('.sums.' + [guid]::NewGuid().ToString('N'))
  $Temps += $SumsFile
  Invoke-WebRequest -UseBasicParsing -Uri "$Url/SHA256SUMS" -OutFile $SumsFile
  $Sums = Get-Content $SumsFile

  # Download and verify everything first; install only when all of it checks out.
  $Plan = @()
  foreach ($name in $Selected) {
    $asset = "$name-$Version-$Platform$Suffix"
    $tmp = Join-Path $Dir (".$name." + [guid]::NewGuid().ToString('N'))
    $Temps += $tmp
    Invoke-WebRequest -UseBasicParsing -Uri "$Url/$asset" -OutFile $tmp
    $line = $Sums | Where-Object { ($_ -split '\s+')[1] -eq $asset } | Select-Object -First 1
    if (-not $line) { throw "No checksum for $asset in SHA256SUMS" }
    $want = ($line -split '\s+')[0].ToLower()
    $got = (Get-FileHash -Algorithm SHA256 -Path $tmp).Hash.ToLower()
    if ($got -ne $want) { throw "Checksum mismatch for $asset (expected $want, got $got)" }
    $Plan += , @($name, $tmp)
  }

  foreach ($p in $Plan) {
    $dest = Join-Path $Dir ($p[0] + $Suffix)
    Move-Item -Force -Path $p[1] -Destination $dest
    Write-Host "Installed $dest"
    # The first start unpacks the PAR cache; do it now rather than on first use.
    try { & $dest --help *> $null } catch { }
  }
}
finally {
  foreach ($t in $Temps) { Remove-Item -Force -ErrorAction SilentlyContinue $t }
}

$onPath = ($env:PATH -split ';') -contains $Dir
if (-not $onPath) { Write-Host "$Dir is not in your PATH; add it to use the installed commands." }
